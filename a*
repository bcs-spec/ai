import heapq
g={'V1':[('V2',2),('V3',4)],'V2':[('V4',3)],
'V3':[('V4',1),('V5',5)],'V4':[('V6',2)],
'V5':[('V6',1)],'V6':[]}
h={'V1':7,'V2':5,'V3':3,'V4':2,'V5':1,'V6':0}
q=[(7,0,'V1',['V1'])]
while q:
f,c,n,p=heapq.heappop(q)
if n=='V6':
print("Path:",' -> '.join(p))
print("Cost:",c)
break
for x,w in g[n]:
heapq.heappush(q,(c+w+h[x],c+w,x,p+[x]))
