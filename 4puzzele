import heapq
start=(1,2,0,3); goal=(1,2,3,0)
def h(s):
return sum(a!=b and a!=0 for a,b in zip(s,goal))
q=[(h(start),start)]
while q:
_,s=heapq.heappop(q)
if s==goal:
print("Goal:",s); break
z=s.index(0)
for n in range(4):
if abs(z-n) in (1,2):
t=list(s); t[z],t[n]=t[n],t[z]
heapq.heappush(q,(h(tuple(t)),tuple(t)))
