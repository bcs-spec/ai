from collections import deque
def bfs():
q = deque([((0, 0), [])])
visited = set()
while q:
(a, b), path = q.popleft()
if (a, b) in visited:
continue
visited.add((a, b))
if a == 2:
print("Solution found:")
for x in path:
print(x)
print("Final state:", (a, b))
return
moves = [
((4, b), "Fill 4L jug"),
((a, 3), "Fill 3L jug"),
((0, b), "Empty 4L jug"),
((a, 0), "Empty 3L jug"),
((a-min(a, 3-b), b+min(a, 3-b)), "Pour 4L -> 3L"),
((a+min(b, 4-a), b-min(b, 4-a)), "Pour 3L -> 4L")
]
for state, action in moves:
q.append((state, path + [action]))
bfs()
